# ================================================
# SOCIALHUB BACKEND — VARIAVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores
# No Render, adicione cada variavel em Environment Variables
# ================================================

# BANCO DE DADOS (gerado automaticamente pelo Render ao criar o Postgres)
DATABASE_URL=postgresql://usuario:senha@host:5432/socialhub

# INFINITEPAY — sua InfiniteTag (SEM o simbolo $)
# Sua tag no app e $socialhub, entao coloque apenas: socialhub
INFINITEPAY_TAG=socialhub

# ANTHROPIC — para gerar posts com IA
# Pegue em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# URLS DO SEU SISTEMA
# BACKEND_URL = URL que o Render te deu (aparece apos o deploy)
BACKEND_URL=https://socialhub-backend.onrender.com
# FRONTEND_URL = onde esta sua pagina de vendas (pode ser o proprio Render)
FRONTEND_URL=https://socialhub.onrender.com

# EMAIL (opcional mas recomendado — gratis ate 3000 emails/mes)
# Pegue em: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# AMBIENTE
NODE_ENV=production
PORT=3000
